# VibeTake reads this file's sibling .env.local at startup. Copy this file to .env.local and fill in
# ONE key. Only the voice track of a recording is sent to the service you pick; nothing else leaves
# your machine. Only these six variables are read from .env.local.

# OpenAI (direct). With both keys set, OpenAI is used unless VIBETAKE_STT_PROVIDER says otherwise.
OPENAI_API_KEY=

# OpenRouter (one key for many models).
OPENROUTER_API_KEY=

# Optional: which provider to use when both keys are set — openai or openrouter.
# VIBETAKE_STT_PROVIDER=openai

# Optional: the speech-to-text model. It must return word timestamps (whisper-1 does).
# On OpenRouter the id is openai/whisper-1.
# VIBETAKE_STT_MODEL=whisper-1

# Optional: another OpenAI-compatible endpoint. Include the version path (…/v1). The key above is
# sent to whatever host this names, over whatever scheme it names — set it only for a service you trust.
# VIBETAKE_STT_BASE_URL=https://api.openai.com/v1

# Optional: the port `npm run serve` listens on (127.0.0.1 only). Never 3000 — that is your app.
# VIBETAKE_PORT=7741
